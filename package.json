{
  "name": "healthcare-appointment-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Healthcare Appointment & Follow-up Manager with AI Clinical Summaries & Concurrency-Safe Booking",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "cd backend && npm test",
    "prisma:generate": "cd backend && npx prisma generate",
    "prisma:seed": "cd backend && npx tsx prisma/seed.ts"
  },
  "keywords": [
    "healthcare",
    "telemedicine",
    "appointment-booking",
    "concurrency",
    "llm",
    "google-gemini",
    "bullmq",
    "google-calendar",
    "prisma",
    "postgresql",
    "react",
    "typescript"
  ],
