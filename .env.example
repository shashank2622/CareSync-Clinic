# ====================================================================
# Healthcare Appointment & Follow-up Manager - Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER COMMIT THE REAL .ENV FILE TO VERSION CONTROL!
# ====================================================================

# Node Environment & Server Port
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL - Neon / Supabase / Local)
# Example: postgresql://postgres:password@localhost:5432/healthcare_db?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/healthcare_db?schema=public

# Redis Connection (Upstash / Local Redis)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets
# Generate strong secrets with: openssl rand -base64 32
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Key for sensitive OAuth tokens at rest (32 bytes hex or base64)
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google Gemini LLM API
# Get an API key from Google AI Studio: https://aistudio.google.com/
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Google Calendar OAuth 2.0 Credentials
# Create OAuth 2.0 Web Application credentials in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# Email Service (Nodemailer / SMTP / SendGrid)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Healthcare Clinic <no-reply@healthcareclinic.com>"

# Booking Hold Settings
SLOT_HOLD_DURATION_MINUTES=5
